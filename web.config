<?xml version="1.0" encoding="UTF-8"?>
<!--
  轩宇-导航 · IIS 安全配置
  适用于 Windows / IIS + PHP 8.1。
  如主机已有自己的 web.config，请把 hiddenSegments、fileExtensions、
  httpErrors、customHeaders 节点合并，不要直接覆盖主机级配置。
-->
<configuration>
    <system.webServer>
        <!--
          v2.18.1 · 自定义错误页：不再向访问者输出 IIS 详细错误（版本号、404.0、
          物理路径）。existingResponse="Replace" 保证 PHP 自己输出的错误页也被替换，
          避免两套错误页面嵌套。
          若主机面板锁定了 httpErrors（web.config 不生效），请在面板的「错误页」
          设置里把 404 指向 /404.php、500 指向 /500.php。
        -->
        <httpErrors errorMode="Custom" existingResponse="Replace" defaultResponseMode="ExecuteURL">
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" path="/404.php" responseMode="ExecuteURL" />
            <remove statusCode="500" subStatusCode="-1" />
            <error statusCode="500" path="/500.php" responseMode="ExecuteURL" />
        </httpErrors>

        <!--
          关于 /api/ 的默认文档：
          v2.10.8 曾在此处 <add value="index.php" />，结果在部分主机上触发
          500.19 / 0x800700b7「重复集合项」—— 这些主机的全局默认文档里
          本来就有 index.php，重复声明会让整个配置失效，导致首页 500。
          因此本文件不再声明 defaultDocument。
          若你的主机默认文档确实没有 index.php，请到主机面板添加，
          或直接使用 /api/index.php（永远可用），不要改这个节点。
        -->

        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="config" />
                    <add segment="includes" />
                    <add segment="install" />
                    <add segment="backups" />
                    <add segment="logs" />
                    <add segment="cache" />
                    <add segment="vendor" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".ini" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".zip" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <httpProtocol>
            <customHeaders>
                <!-- v2.18.1 · 去掉 PHP 版本暴露（Server 头由 IIS 自身输出，普通站点无权移除，留空即可） -->
                <remove name="X-Powered-By" />
                <!--
                  v2.18.5 · 这四条 + CSP 只由 IIS 下发（能覆盖 css/js 等不经过 PHP 的静态资源）；
                  includes/bootstrap.php 检测到 Microsoft-IIS 时会跳过发送，避免每个响应头出现两次。
                  CSP 先发 Report-Only 观察一轮，确认没有误拦后再改成 Content-Security-Policy。
                -->
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
                <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
            </customHeaders>
        </httpProtocol>

        <!--
          可选：为开放 API 提供不带 .php 的地址（/api/sites → api/sites.php）。
          需要先安装 IIS URL Rewrite 模块；未安装时该节点会被忽略，
          直接使用 /api/sites.php 访问即可。
        -->
        <rewrite>
            <rules>
                <rule name="NavApiSites" stopProcessing="true">
                    <match url="^api/sites/?$" />
                    <action type="Rewrite" url="api/sites.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
