# 上传目录：只允许图片访问，禁止脚本执行。
#
# v2.19 任务3 · 全站统一口径：前台用户上传仅允许位图与 ICO（禁 SVG）；
# 后台远程抓取的 SVG 经校验后仅作 <img> 图片引用，配合本文件下方的 nosniff +
# CSP sandbox 隔离，不执行其中脚本。故 svg 不在禁止列表内。其余可执行后缀一律拒绝。
<FilesMatch "\.(php|phtml|phar|asp|aspx|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# SVG 只允许当图片用：加 nosniff + CSP，即使被直接打开也不会执行内联脚本
<FilesMatch "\.svg$">
    ForceType image/svg+xml
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </IfModule>
</FilesMatch>

Options -Indexes
